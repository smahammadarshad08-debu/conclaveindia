#!/usr/bin/env python3
"""
Render / Cloud PaaS 'start' Executable Entrypoint
================================================
Invoked when Render or Unix environments run 'start', './start',
or 'python start'. Automatically delegates to server.py.
"""

import os
import sys

# Add current directory to path
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
if BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)

import server

if __name__ == "__main__":
    server.run()
